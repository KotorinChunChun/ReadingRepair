<Application x:Class="ReadingRepair.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#E7EEF8"/><Setter Property="Foreground" Value="#163654"/><Setter Property="BorderBrush" Value="#B8C9DE"/><Setter Property="MinHeight" Value="38"/><EventSetter Event="Loaded" Handler="ButtonLoaded"/><EventSetter Event="ToolTipOpening" Handler="ButtonToolTipOpening"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="#B8C9DE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="#D1DCE8"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeight" Value="38"/><Setter Property="AlternatingRowBackground" Value="#F2F6FB"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E0E7F0"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="22,11"/></Style>
  </Application.Resources>
</Application>
