<Window x:Class="ReadingRepair.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ReadingRepair" Width="1220" Height="850" MinWidth="980" MinHeight="680" Background="#EDF2F7" FontFamily="Yu Gothic UI" FontSize="14">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,14"><Button DockPanel.Dock="Right" Content="依存を診断" AutomationProperties.AutomationId="Diagnose" Click="Doctor_Click"/><TextBlock Text="ReadingRepair" FontSize="27" FontWeight="SemiBold" Foreground="#183750" VerticalAlignment="Center"/></DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0"><ProgressBar x:Name="Progress" Height="4" Foreground="#2675C8"/><TextBlock x:Name="StatusText" Text="準備完了" Margin="2,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="Status"/></StackPanel>
    <TabControl x:Name="Tabs" Background="White" BorderBrush="#D1DCE8" SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="変換"><Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <GroupBox Header="原文"><TextBox x:Name="OriginalInput" AutomationProperties.AutomationId="OriginalInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" VerticalContentAlignment="Top" FontSize="17"/></GroupBox>
        <GroupBox Header="指定する正しい読み（任意）" Grid.Column="1"><TextBox x:Name="KnownInput" AutomationProperties.AutomationId="KnownReadings" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ToolTip="1行ごとに 表記=カタカナ読み を入力します。文脈を限定する場合は語句全体を指定します。"/></GroupBox>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8">
          <Button x:Name="RepairButton" Content="変換の開始" AutomationProperties.AutomationId="StartRepair" Click="Repair_Click" Background="#236BB4" Foreground="White"/><Button x:Name="VerifyButton" Content="検証のみ" AutomationProperties.AutomationId="StartVerify" Click="Verify_Click"/><Button Content="原文を開く" Click="LoadText_Click"/>
          <Button x:Name="TestPlaybackButton" Content="テスト再生" AutomationProperties.AutomationId="TestPlayback" Click="TestPlayback_Click" IsEnabled="False" ToolTip="選択した実行の生成済み音声を再生します。登録後の音声を優先します。"/><Button Content="再生を停止" Click="StopAudio_Click"/>
          <Button x:Name="ResumeButton" Content="選択した実行を再開" AutomationProperties.AutomationId="Resume" Click="Resume_Click" IsEnabled="False"/><Button x:Name="StopButton" Content="停止" AutomationProperties.AutomationId="Stop" Click="Stop_Click" IsEnabled="False"/>
        </WrapPanel>
        <GroupBox Grid.Row="2" Header="進行状況"><TextBox x:Name="ProgressLog" AutomationProperties.AutomationId="ProgressLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="1" Header="登録前チェック"><DataGrid x:Name="CandidateChecks" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="表記" Binding="{Binding Surface}" Width="*"/><DataGridTextColumn Header="状態" Binding="{Binding State}" Width="120"/></DataGrid.Columns></DataGrid></GroupBox>
      </Grid></TabItem>
      <TabItem Header="確認待ち"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListBox x:Name="Questions" AutomationProperties.AutomationId="Questions" SelectionChanged="Questions_SelectionChanged" Margin="4" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ProposalLabel}" TextWrapping="Wrap" Margin="0,4"/><StackPanel Orientation="Horizontal"><Button Content="採用" Click="QuickAccept_Click" AutomationProperties.AutomationId="QuickAccept"/><Button Content="不採用" Click="QuickReject_Click" AutomationProperties.AutomationId="QuickReject"/></StackPanel><TextBlock Text="{Binding DecisionState}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,0,0,0">
          <TextBlock Text="原文の文脈" Margin="6,4" FontWeight="SemiBold"/><TextBox x:Name="QuestionContext" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65"/>
          <TextBlock Text="モデルの意見" Margin="6,8,6,0" FontWeight="SemiBold"/><TextBox x:Name="Opinions" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="85"/>
          <TextBlock Text="判断" Margin="6,8,6,0"/><ComboBox x:Name="Decision" AutomationProperties.AutomationId="Decision" SelectedIndex="0"><ComboBoxItem Content="未回答"/><ComboBoxItem Content="採用する"/><ComboBoxItem Content="登録しない"/></ComboBox>
          <TextBlock Text="対象語の読み" Margin="6,8,6,0"/><ComboBox x:Name="ChosenReading" AutomationProperties.AutomationId="ChosenReading" IsEditable="True"/>
          <TextBlock Text="辞書へ登録する語句" Margin="6,8,6,0"/><TextBox x:Name="RegistrationSurface" AutomationProperties.AutomationId="RegistrationSurface" ToolTip="例：上手だけでなく、舞台の上手。空欄なら対象語を使用します。"/>
          <TextBlock Text="登録する語句全体の読み" Margin="6,8,6,0"/><TextBox x:Name="RegistrationReading" AutomationProperties.AutomationId="RegistrationReading" ToolTip="例：ブタイノカミテ"/>
          <TextBlock Text="判断の理由" Margin="6,8,6,0"/><TextBox x:Name="DecisionReason" AutomationProperties.AutomationId="DecisionReason" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <WrapPanel Margin="0,10,0,0"><Button Content="回答を保存" AutomationProperties.AutomationId="SaveAnswer" Click="SaveAnswer_Click"/><Button Content="回答を反映して再開" AutomationProperties.AutomationId="AnswerAndResume" Click="AnswerResume_Click"/><Button Content="モデル照会を再試行" AutomationProperties.AutomationId="RetryReviewers" Click="Retry_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="履歴"><DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="更新" Click="Refresh_Click"/><Button Content="HTML履歴を開く" AutomationProperties.AutomationId="OpenReport" Click="Report_Click"/><Button Content="登録前の音声" AutomationProperties.AutomationId="PlayBefore" Click="PlayBefore_Click"/><Button Content="登録後の音声" AutomationProperties.AutomationId="PlayAfter" Click="PlayAfter_Click"/><Button Content="再生を停止" Click="StopAudio_Click"/></WrapPanel>
        <DataGrid x:Name="HistoryGrid" AutomationProperties.AutomationId="History" IsReadOnly="True" SelectionMode="Single" SelectionChanged="History_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="実行" Binding="{Binding Label}" Width="220"/><DataGridTextColumn Header="状態" Binding="{Binding State}" Width="160"/><DataGridTextColumn Header="登録前" Binding="{Binding Before}" Width="75"/><DataGridTextColumn Header="登録後" Binding="{Binding After}" Width="75"/><DataGridTextColumn Header="原文" Binding="{Binding Original}" Width="*"/></DataGrid.Columns></DataGrid>
      </DockPanel></TabItem>
      <TabItem Header="設定"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="SaveSettingsButton" Content="設定を保存" AutomationProperties.AutomationId="SaveSettings" Click="SaveSettings_Click"/><Button Content="再読込" Click="ReloadSettings_Click"/></StackPanel><DataGrid x:Name="SettingsGrid" AutomationProperties.AutomationId="Settings" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="項目" Binding="{Binding Label}" Width="270" IsReadOnly="True"/><DataGridTextColumn Header="設定値" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
      <TabItem Header="ユーザー辞書"><Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="135"/></Grid.RowDefinitions>
        <DockPanel><Button DockPanel.Dock="Right" Content="最新の辞書を取得" AutomationProperties.AutomationId="RefreshDictionary" Click="DictionaryRefresh_Click"/><TextBlock x:Name="DictionarySummary" Margin="6" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
        <DataGrid Grid.Row="1" x:Name="DictionaryGrid" AutomationProperties.AutomationId="CurrentDictionary" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="順序" Binding="{Binding Priority}" Width="65"/><DataGridTextColumn Header="表記" Binding="{Binding Surface}" Width="*"/><DataGridTextColumn Header="読み" Binding="{Binding Reading}" Width="*"/><DataGridTextColumn Header="アクセント核" Binding="{Binding Accent}" Width="100"/><DataGridTextColumn Header="状態" Binding="{Binding State}" Width="110"/></DataGrid.Columns></DataGrid>
        <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="追加する表記" Margin="6,0"/><TextBox x:Name="DictionarySurface" AutomationProperties.AutomationId="DictionarySurface" MaxLength="80" TextChanged="DictionaryCandidate_Changed" ToolTip="文脈で読みが変わる場合は語句全体を入力します。"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="追加する読み" Margin="6,0"/><TextBox x:Name="DictionaryReading" AutomationProperties.AutomationId="DictionaryReading" MaxLength="160" TextChanged="DictionaryCandidate_Changed" ToolTip="全角カタカナの読みを入力します。"/></StackPanel></Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal"><Button x:Name="CheckDictionaryButton" Content="重複・競合を確認" AutomationProperties.AutomationId="CheckDictionary" Click="DictionaryCheck_Click"/><Button x:Name="AddDictionaryButton" Content="確認した候補を追加" AutomationProperties.AutomationId="AddDictionary" Click="DictionaryAdd_Click" IsEnabled="False"/></StackPanel>
        <DataGrid Grid.Row="4" x:Name="DictionaryChecks" AutomationProperties.AutomationId="DictionaryChecks" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="表記" Binding="{Binding Surface}" Width="*"/><DataGridTextColumn Header="候補の読み" Binding="{Binding Reading}" Width="*"/><DataGridTextColumn Header="状態" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="既存の読み" Binding="{Binding Existing}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
      <TabItem x:Name="LlmTab" Header="LLM送受信"><DockPanel Margin="16"><Button DockPanel.Dock="Top" Content="送受信ログを更新" Click="LlmRefresh_Click" HorizontalAlignment="Right"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListBox x:Name="LlmCalls" AutomationProperties.AutomationId="LlmCalls" SelectionChanged="LlmCall_SelectionChanged" DisplayMemberPath="Label"/>
        <Grid Grid.Column="1" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="LlmMetadata" TextWrapping="Wrap" Margin="6"/>
          <GroupBox Grid.Row="1" Header="送信内容"><TextBox x:Name="LlmRequest" AutomationProperties.AutomationId="LlmRequest" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></GroupBox>
          <GroupBox Grid.Row="2" Header="受信内容"><TextBox x:Name="LlmResponse" AutomationProperties.AutomationId="LlmResponse" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></GroupBox>
        </Grid>
      </Grid></DockPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
