# VoiSona Talk（ローカルAPI接続。既存の値を外部ファイルへ設定）
VOISONA_BASE_URL=http://127.0.0.1:32766
VOISONA_USER=
VOISONA_PASSWORD=

# http-wavエンジン。JSONをPOSTしてPCM WAVを返すAPI。
# サービス固有のmodel等はTTS_BODY_JSONへ追加できます。
TTS_URL=https://your-tts-service.example/v1/audio/speech
TTS_API_KEY=
TTS_BODY_JSON={"input":"{text}","voice":"{voice}","response_format":"wav"}
