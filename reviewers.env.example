# 読み検証の外部照会設定。実ファイルは C:\AI\env\voisona-reading-review.env に置きます。
# キーはこの実ファイルへ記入し、チャット・Git・検証ログには貼らないでください。
GEMINI_REVIEW_ENABLED=true
# 独立CLIの既定。Windowsアプリでは画面の接続方式（既定api）を使います。
GEMINI_REVIEW_TRANSPORT=cli
GEMINI_CLI_PATH=gemini
# CLIは空欄なら既定モデル、api接続ではモデル名の指定が必要です。
GEMINI_MODEL=
GEMINI_API_KEY=

SARASHINA_REVIEW_ENABLED=true
SARASHINA_BASE_URL=https://api.sarashina.ai/v1
SARASHINA_MODEL=sarashina3-mini
SARASHINA_API_KEY=

REVIEW_TIMEOUT_SECONDS=120
